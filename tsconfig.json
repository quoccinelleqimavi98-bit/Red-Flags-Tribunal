{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@components/*": ["src/components/*"],
      "@screens/*": ["src/screens/*"],
      "@games/*": ["src/games/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
